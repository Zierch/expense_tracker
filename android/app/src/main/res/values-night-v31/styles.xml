<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ splash screen (system-drawn), dark mode -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_background</item>
        <!-- The app paints its own page colour behind the bars and tells the
             system so at runtime (see `systemUiStyleFor` in lib/main.dart).
             Android's automatic contrast scrim would otherwise be laid over
             that colour, and on a Xiaomi on Android 16 it picked a white one
             under a dark theme. -->
        <item name="android:enforceNavigationBarContrast">false</item>
        <!-- Light icons on a dark bar. -->
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <!-- The app paints its own page colour behind the bars and tells the
             system so at runtime (see `systemUiStyleFor` in lib/main.dart).
             Android's automatic contrast scrim would otherwise be laid over
             that colour, and on a Xiaomi on Android 16 it picked a white one
             under a dark theme. -->
        <item name="android:enforceNavigationBarContrast">false</item>
        <!-- Light icons on a dark bar. -->
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
