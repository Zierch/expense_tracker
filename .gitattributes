# Normalise line endings in the repository so that Windows and Linux/macOS
# contributors do not produce whole-file diffs on every commit, and so that
# shell scripts do not arrive on Linux with a stray carriage return.
#
# This matters here: the Flutter SDK's own shell scripts break with
# "line 5: $'\r': command not found" when they carry CRLF, and the same class
# of bug hits gradlew if it is ever committed with Windows endings.
* text=auto eol=lf

# Windows-only files that must keep CRLF to work.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Note: the Gradle wrapper scripts under android/ are git-ignored and
# regenerated by the Flutter tool, so they need no line-ending rules here.

# Binary assets -- never diff, never normalise.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.webp    binary
*.ico     binary
*.ttf     binary
*.otf     binary
*.jks     binary
*.keystore binary
